# Copy to .env for local runs. In GitHub Actions these come from repository secrets.

# Scoring endpoint. It is private: keep it in .env locally and in the
# LLM_BASE_URL repository secret in GitHub Actions. Never commit a real URL.
# LLM_BASE_URL=https://your-llm-endpoint/v1
# LLM_MODEL=DeepSeek-V4.1-Flash-1017
# LLM_API_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-char-google-app-password
EMAIL_TO=you@example.com

# 1 = headless. Set 0 on a machine with a display if Cloudflare blocks you.
HEADLESS=1

# Uncomment to scan and build the report without sending email.
# DRY_RUN=1
